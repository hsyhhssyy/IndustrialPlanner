{
  "name": "industrial-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run --project normal",
    "test:normal": "vitest run --project normal",
    "test:blueprint": "vitest run --project blueprint",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "blueprint:convert": "tsx --tsconfig tsconfig.app.json src/scripts/convert-legacy-blueprint.ts",
    "draw-device-blueprint-svg": "tsx --tsconfig tsconfig.app.json src/scripts/draw-device-blueprint-svg.mjs",
    "format-device-sprites": "node src/scripts/format-device-sprites.mjs",
    "split-device-sprites": "node src/scripts/split-device-sprites.mjs",
    "compare-exported-devices": "node src/scripts/compare-exported-devices.mjs",
    "audit-item-names": "node .agents/skills/unpack-data-analysis/scripts/audit-item-names.mjs",
    "fetch-akedata-tables": "node .agents/skills/unpack-data-analysis/scripts/fetch-akedata-tables.mjs",
    "generate-textures": "node src/scripts/texture-gen/generate-all-textures.mjs",
    "generate-liquid-port-chevron": "node src/scripts/texture-gen/generate-liquid-port-chevron.mjs",
    "generate-solid-port-chevron": "node src/scripts/texture-gen/generate-solid-port-chevron.mjs",
    "generate-flow-texture": "node src/scripts/texture-gen/generate-flow-texture.mjs",
    "generate-logistics-delete-icon": "node src/scripts/icon-gen/generate-logistics-delete-icon.mjs",
    "remove-white-background": "node src/scripts/remove-white-background.mjs"
  },
  "dependencies": {
    "fast-json-patch": "^3.1.1",
    "marked": "^18.0.5",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "pinyin-pro": "^3.28.1",
    "pixi.js": "^8.17.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "webdav": "^5.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@iconify-json/ant-design": "^1.2.5",
    "@iconify-json/gis": "^1.2.5",
    "@iconify-json/lucide": "^1.2.102",
    "@iconify-json/material-symbols": "^1.2.69",
    "@iconify-json/mdi": "^1.2.3",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "opentype.js": "^2.0.0",
    "playwright": "^1.59.1",
    "sass": "^1.99.0",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.2"
  }
}
