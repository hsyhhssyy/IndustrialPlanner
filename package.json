{
  "name": "industrialplanner",
  "private": true,
  "version": "0.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "predev": "npm run gen:blueprint-index",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run gen:blueprint-index",
    "build": "tsc -b && vite build",
    "validate:flow": "esbuild src/test/validate-blueprint-throughput.ts --bundle --platform=node --format=esm --outfile=.temp/validate-blueprint-throughput.mjs && node .temp/validate-blueprint-throughput.mjs",
    "validate:blueprint": "npm run validate:flow --",
    "pretest-preview": "npm run gen:blueprint-index",
    "test-preview": "tsc -b && vite build --emptyOutDir --outDir .temp/test-dist && vite preview --host 0.0.0.0 --strictPort --port 8000 --outDir .temp/test-dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "assets:normalize": "node scripts/normalize-assets.mjs",
    "assets:refresh": "npm run gen:filled-icons && npm run gen:chrono-icons && npm run assets:normalize",
    "export:end-wiki-recipes:zh": "node scripts/export-end-wiki-recipes-zh.mjs",
    "gen:filled-icons": "node scripts/generate-filled-bottle-icons.mjs",
    "gen:chrono-icons": "node scripts/generate-chrono-item-icons.mjs",
    "gen:blueprint-index": "node scripts/generate-blueprint-index.mjs"
  },
  "dependencies": {
    "pinyin-pro": "^3.28.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "opentype.js": "^1.3.4",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
