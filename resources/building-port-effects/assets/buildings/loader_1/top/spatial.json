{
  "schemaVersion": 1,
  "unit": "factory-grid-cell",
  "imageOrigin": "top-left",
  "imageAxes": {
    "x": "+sourceX",
    "y": "+sourceZ"
  },
  "coordinateSystem": "PixiJS-style 2D canvas; origin top-left; x right; y down",
  "canvasCells": {
    "width": 3,
    "height": 2
  },
  "framePixels": {
    "width": 384,
    "height": 256
  },
  "pixelsPerCell": {
    "x": 128,
    "y": 128
  },
  "footprintRectCells": {
    "left": 0,
    "top": 0,
    "width": 3,
    "height": 1,
    "source": "FactoryBuildingTable.range"
  },
  "pivotCells": {
    "x": 1.5,
    "y": 1.0
  },
  "pivotPixels": {
    "x": 192.0,
    "y": 128.0
  },
  "anchorNormalized": {
    "x": 0.5,
    "y": 0.5
  },
  "placementRule": {
    "description": "When gridX/gridY is the logical footprint top-left, place the sprite canvas at gridX-left, gridY-top.",
    "spriteCanvasLeft": "gridX - footprintRectCells.left",
    "spriteCanvasTop": "gridY - footprintRectCells.top"
  },
  "verticalTransform": {
    "operation": "flip-top-bottom",
    "sourceImageAxisY": "-sourceZ",
    "resultImageAxisY": "+sourceZ",
    "sourceFramePixels": [
      1280,
      1280
    ],
    "resultFramePixels": [
      384,
      256
    ],
    "resized": false,
    "cropRectPixels": [
      448,
      576,
      832,
      832
    ]
  }
}
