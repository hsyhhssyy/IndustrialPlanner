{
  "schemaVersion": 1,
  "unit": "factory-grid-cell",
  "imageOrigin": "top-left",
  "imageAxes": {
    "x": "+sourceX",
    "y": "+sourceZ"
  },
  "canvasCells": {
    "width": 5,
    "height": 5
  },
  "framePixels": {
    "width": 640,
    "height": 640
  },
  "pixelsPerCell": {
    "x": 128,
    "y": 128
  },
  "footprintRectCells": {
    "left": 0,
    "top": 0,
    "width": 4,
    "height": 4,
    "source": "FactoryBuildingTable.range"
  },
  "pivotCells": {
    "x": 2.0,
    "y": 2.0
  },
  "pivotPixels": {
    "x": 256.0,
    "y": 256.0
  },
  "anchorNormalized": {
    "x": 0.4,
    "y": 0.4
  },
  "placementRule": {
    "spriteCanvasLeft": "gridX - footprintRectCells.left",
    "spriteCanvasTop": "gridY - footprintRectCells.top"
  },
  "verticalTransform": {
    "operation": "none",
    "sourceImageAxisY": "+sourceZ",
    "resultImageAxisY": "+sourceZ",
    "sourceFramePixels": [
      768,
      768
    ],
    "resultFramePixels": [
      640,
      640
    ],
    "resized": false,
    "cropRectPixels": [
      128,
      128,
      768,
      768
    ]
  },
  "solidPorts": [],
  "portConvention": {
    "inputStrip": "white",
    "outputStrip": "yellow",
    "flow": "input toward machine; output away from machine",
    "source": "FactoryBuildingTable and selected machine-mode buffer bindings"
  }
}
